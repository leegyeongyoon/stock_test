# ===== Binance API =====
# Paper 모드 (Testnet)
BINANCE_TESTNET_API_KEY=your_testnet_api_key
BINANCE_TESTNET_SECRET=your_testnet_secret

# Live 모드 (주의: ENABLE_LIVE_TRADING=true 필요)
BINANCE_API_KEY=your_live_api_key
BINANCE_SECRET=your_live_secret

# ===== 운영 모드 =====
# false: Paper 모드 (기본값, 안전)
# true: Live 모드 (실제 주문 - 주의!)
ENABLE_LIVE_TRADING=false

# ===== 데이터베이스 =====
# SQLite (개발용)
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# Postgres (프로덕션)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading

# ===== Telegram 알림 =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ===== 서버 설정 =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== Risk 파라미터 =====
DAILY_LOSS_LIMIT_SAFE=-0.015
DAILY_LOSS_LIMIT_HALT=-0.030
RECONCILE_INTERVAL_SEC=10
MAX_ORDER_FAILURE_RATE=0.3
