# ===== 거래소 선택 =====
# upbit: 업비트 (KRW 현물)
# binance: 바이낸스 (USDT 현물+선물)
EXCHANGE_TYPE=upbit

# ===== Upbit API =====
UPBIT_ACCESS_KEY=your_upbit_access_key
UPBIT_SECRET_KEY=your_upbit_secret_key

# ===== Binance API (레거시) =====
# Paper 모드 (Testnet)
BINANCE_TESTNET_API_KEY=your_testnet_api_key
BINANCE_TESTNET_SECRET=your_testnet_secret

# Live 모드 (주의: ENABLE_LIVE_TRADING=true 필요)
BINANCE_API_KEY=your_live_api_key
BINANCE_SECRET=your_live_secret

# ===== 운영 모드 =====
# false: Paper 모드 (기본값, 안전)
# true: Live 모드 (실제 주문 - 주의!)
ENABLE_LIVE_TRADING=false

# Upbit은 Futures 없음
FUTURES_ONLY_MODE=false

# ===== 데이터베이스 =====
# SQLite (개발용)
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# Postgres (프로덕션)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading

# ===== Telegram 알림 =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ===== 서버 설정 =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== Risk 파라미터 =====
DAILY_LOSS_LIMIT_SAFE=-0.015
DAILY_LOSS_LIMIT_HALT=-0.030
RECONCILE_INTERVAL_SEC=10
MAX_ORDER_FAILURE_RATE=0.3

# ===== Position State Machine (PSM) =====
# 점수 임계값
PSM_WEAK_THRESHOLD=40.0
PSM_STRONG_THRESHOLD=70.0
PSM_EXTREME_THRESHOLD=85.0

# 볼륨 점수 (RVOL 기준)
PSM_RVOL_STRONG=4.0
PSM_RVOL_GOOD=2.5
PSM_RVOL_NORMAL=1.5

# VWAP 점수 (VWAP 대비 거리)
PSM_VWAP_ABOVE_STRONG=0.005
PSM_VWAP_ABOVE_NORMAL=0.0
PSM_VWAP_BELOW_WEAK=-0.003
PSM_VWAP_BELOW_CRITICAL=-0.008

# 캔들 강도 (ClosePos)
PSM_CLOSE_POS_STRONG=0.85
PSM_CLOSE_POS_GOOD=0.70

# 모멘텀 (3봉 변화율)
PSM_MOMENTUM_STRONG=0.02
PSM_MOMENTUM_WEAK=0.01

# 과열 감지
PSM_OVERHEAT_RVOL=6.0
PSM_OVERHEAT_WICK_RATIO=1.5

# 타임스톱 (분)
PSM_WEAK_TIME_STOP_MIN=15
PSM_NORMAL_TIME_STOP_MIN=30

# 타임스톱 R 조건
PSM_WEAK_MIN_R=0.3
PSM_NORMAL_MIN_R=0.5

# ATR 배수 (스탑 계산용)
PSM_INITIAL_STOP_ATR=1.2
PSM_WEAK_STOP_ATR=0.3
PSM_NORMAL_TRAILING_ATR=0.8
PSM_STRONG_TRAILING_ATR=1.2
PSM_EXTREME_STOP_ATR=0.1

# 익절 R 레벨
PSM_TP1_R=0.8
PSM_TP2_R=1.5
PSM_TP2_STRONG_R=2.0

# 익절 비율
PSM_TP1_PCT_NORMAL=0.30
PSM_TP1_PCT_STRONG=0.20
PSM_TP2_PCT=0.30
PSM_EXTREME_TP_PCT=0.50

# 쿨다운 (분)
PSM_EXTREME_COOLDOWN_MIN=60

# ===== Risk Overlay (MDD 5% 방어) =====
# 드로우다운 임계값
RISK_DD_SAFE_THRESHOLD=0.01
RISK_DD_REDUCE_THRESHOLD=0.03
RISK_DD_HALT_THRESHOLD=0.05

# 일일 손실 한도
DAILY_LOSS_SAFE=-0.015
DAILY_LOSS_HALT=-0.03

# 실행 건강도 (Exec Health)
EXEC_WS_LATENCY_WARN_MS=500
EXEC_WS_LATENCY_SAFE_MS=1000
EXEC_ORDER_FAILURE_RATE_MAX=0.10
EXEC_ORDER_ACK_TIMEOUT_MS=3000
EXEC_RECONCILE_DRIFT_MAX=0.01
EXEC_HEALTH_WINDOW=20

# 상관관계 가드 (Correlation Guard)
CORR_SPIKE_THRESHOLD=0.80
CORR_LOOKBACK_BARS=20
CORR_BTC_DROP_PCT=-0.03
CORR_BTC_VOLATILITY_SPIKE=2.0

# 슬리피지
SLIPPAGE_BUFFER_PCT=0.005
MAX_SLIPPAGE_PCT=0.01

# Core 전략 안전장치
CORE_ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT
CORE_MIN_FUNDING_RATE=-0.0001
CORE_NEGATIVE_FUNDING_EXIT=-0.0003
CORE_MIN_EDGE_BPS=5

# 노출 한도
MAX_TOTAL_EXPOSURE_PCT=0.80
MAX_SINGLE_POSITION_PCT=0.10
MAX_CORRELATION_EXPOSURE=3

# ===== Upbit 전용 설정 =====
# 최소 거래대금 (KRW)
MIN_LIQUIDITY_KRW=1000000000

# Defensive Core 현금 비중
CORE_CASH_RATIO_RISK_ON=0.50
CORE_CASH_RATIO_NEUTRAL=0.70
CORE_CASH_RATIO_RISK_OFF=0.85
CORE_CASH_RATIO_VOLATILE=0.90

# Core 리밸런싱
CORE_REBALANCE_INTERVAL_MIN=60
CORE_REBALANCE_THRESHOLD=0.05
